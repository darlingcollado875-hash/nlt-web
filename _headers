# Equivalente Cloudflare Pages de los [[headers]] de netlify.toml -- evita
# que Cloudflare sirva HTML cacheado tras cada deploy (mismo motivo que en
# Netlify: los .html referencian nlt-shared.js/nlt-api-client.js por nombre
# fijo, sin hash de versión, así que sin esto un usuario podría quedarse con
# una versión vieja del HTML apuntando a lógica JS ya cambiada).
/*.html
  Cache-Control: no-cache

# Content-Type explícito para SEO/indexación -- Cloudflare ya infiere bien
# estos dos por extensión, pero se fija acá para que nunca dependa de eso
# (ver pedido explícito de que /sitemap.xml devuelva application/xml).
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

# Frames/capturas/video del showcase: nombres estables y contenido que solo cambia
# al regenerarlos -- una semana de cache alcanza y evita re-descargar ~2 MB.
/assets/img/showcase/*
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# El Service Worker de Web Push (sw.js) tiene que poder actualizarse rápido
# -- un sw.js viejo servido desde caché tras un fix real es justo el tipo
# de bug silencioso que ya motivó el mismo header para los .html.
/sw.js
  Cache-Control: no-cache

# --- Velocidad: JS/CSS versionados ------------------------------------------------------------------
# Todo <script>/<link> de assets/js y assets/css lleva ?v=<hash del contenido> (python3 tools/stamp_versions.py): si el
# archivo cambia, cambia la URL. El navegador los reutiliza un día sin preguntar nada al servidor (visitas siguientes:
# cero esperas); pasado el día revalida con ETag (respuesta 304, casi gratis). No se usa "immutable" a propósito: así un
# sello olvidado nunca deja a nadie con código viejo más de un día. El worker de NLT Script hereda el ?v= de nlts.js.
/assets/js/*
  Cache-Control: public, max-age=86400

/assets/css/*
  Cache-Control: public, max-age=86400

# Librerías de terceros AUTOALOJADAS (Supabase, KLineChart, Chart.js, iconos Phosphor): el nombre del archivo lleva la versión, así que
# nunca cambian bajo la misma URL -> un año de caché y sin revalidar. Antes salían de jsdelivr/unpkg (dos conexiones y dos TLS más por
# página, y una página sin Supabase si el CDN fallaba o estaba bloqueado).
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
