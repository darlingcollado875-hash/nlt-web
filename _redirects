# Cloudflare Pages usa el mismo formato de _redirects que Netlify (from, to,
# status, soporte de :splat) -- este archivo es el equivalente exacto de los
# [[redirects]] de netlify.toml, para cuando el sitio se sirva desde
# Cloudflare Pages en vez de Netlify. netlify.toml se deja intacto (sigue
# siendo el deploy real hasta que se migre de verdad).

# El proxy del tokenizador de Pay2Commerce (bug real de tokenizer.js v1.0.0,
# ver el comentario largo en netlify.toml) NO se puede resolver acá --
# confirmado real en el deploy (14/08): la plataforma actual de Cloudflare
# (Workers con Static Assets, ya no la Pages clásica) rechaza el build
# entero si un redirect "proxy" (status 200) apunta a una URL externa
# absoluta -- "Proxy (200) redirects can only point to relative paths".
# Pendiente: reimplementar este proxy como una Cloudflare Function real
# (functions/api/v1/tokens.js + functions/public/payment-config/[[path]].js
# con fetch() del lado servidor) cuando se retome el arreglo de pagos --
# hasta entonces, el checkout con tarjeta vía Pay2Commerce NO va a andar
# en este deploy de Cloudflare (sí seguía andando en Netlify, que no tiene
# esta restricción).

# Las rutas limpias para los portales del ecosistema (/ecosystem,
# /copy-system, /indicator, /plans, /academy, /news, /calculators, /tools,
# /community) YA NO están acá -- confirmado real en el deploy (14/08): el
# motor de Workers Static Assets de Cloudflare limpia las URLs .html por su
# cuenta (mismo comportamiento, /foo.html -> redirect 307 -> /foo), y como
# antes ACÁ TAMBIÉN reescribíamos /foo -> /foo.html, las dos redirecciones
# se pisaban entre sí y formaban un loop infinito (confirmado con curl -L:
# "Maximum (50) redirects followed" en cada una de esas 9 rutas). Sacarlas
# de acá no rompe nada -- la plataforma ya hace exactamente lo mismo sola.

/verify/:code  /verify.html?code=:code  200

# NLT Prop Hub -- /funded ya es gratis solo con nombrar el archivo funded.html
# (la plataforma limpia .html sola, ver arriba). /funded/<slug> SÍ necesita
# esta reescritura -- no hay un archivo estático por cada prop firm.
#
# BUG REAL confirmado en producción (01/09): apuntar el destino CON extensión
# (/funded-detail.html?slug=:slug) dispara el mismo auto-clean de arriba
# sobre el resultado de ESTE rewrite -- Cloudflare responde 307 a
# /funded-detail SIN el query string, perdiendo el slug (mismo bug real que
# ya afecta a /verify/:code de arriba, confirmado con curl -- no introducido
# acá, pero si el destino del rewrite ya viene SIN extensión, coincide con
# la forma "limpia" que la plataforma sirve directo sin redirigir, y el
# problema desaparece).
/funded/:slug  /funded-detail?slug=:slug  200
